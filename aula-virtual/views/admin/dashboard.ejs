<%- include('../layouts/admin-header', { title: 'Contenido', adminName }) %>

<div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Contenido de la biblioteca</h1>
    <a href="/admin/contenido/nuevo"
        class="rounded-lg bg-green-800 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700">
        + Nuevo
    </a>
</div>

<% if (items.length === 0) { %>
    <p class="mt-8 rounded-lg border border-ink-900/10 bg-ink-900/[0.02] p-6 text-center text-ink-600">
        Todavía no hay nada cargado. Empezá con "+ Nuevo".
    </p>
<% } else { %>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
        <% items.forEach(item => { %>
            <div class="overflow-hidden rounded-2xl border border-ink-900/10 bg-white shadow-card">
                <% if (item.cover_path) { %>
                    <img src="<%= item.cover_path %>" alt="" class="h-32 w-full object-cover">
                <% } else { %>
                    <div class="flex h-32 items-center justify-center bg-ink-900/[0.04] text-3xl">📘</div>
                <% } %>
                <div class="p-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-green-700">
                        <%= item.type === 'book' ? 'Cuento' : item.type === 'video' ? 'Video' : 'Actividad' %>
                        <% if (item.subject_name) { %> · <%= item.subject_name %><% } %>
                    </p>
                    <p class="mt-1 font-medium"><%= item.title %></p>
                    <form method="POST" action="/admin/contenido/<%= item.id %>/eliminar" class="mt-3"
                        onsubmit="return confirm('¿Eliminar este contenido?');">
                        <button type="submit" class="text-sm text-rose-600 hover:text-rose-700">Eliminar</button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<%- include('../layouts/admin-footer') %>
