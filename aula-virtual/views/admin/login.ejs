<%- include('../layouts/admin-header', { title: 'Entrar' }) %>

<div class="mx-auto max-w-sm">
    <h1 class="text-2xl font-semibold">Panel del Aula Virtual</h1>
    <p class="mt-1 text-sm text-ink-600">Solo para el colegio.</p>

    <% if (error) { %>
        <p class="mt-4 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= error %></p>
    <% } %>

    <form method="POST" action="/admin/login" class="mt-6 space-y-4">
        <div>
            <label class="block text-sm font-medium text-ink-600">Correo</label>
            <input type="email" name="email" required
                class="mt-1 w-full rounded-lg border border-ink-900/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-700">
        </div>
        <div>
            <label class="block text-sm font-medium text-ink-600">Contraseña</label>
            <input type="password" name="password" required
                class="mt-1 w-full rounded-lg border border-ink-900/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-700">
        </div>
        <button type="submit"
            class="w-full rounded-lg bg-green-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-green-700">
            Entrar
        </button>
    </form>
</div>

<%- include('../layouts/admin-footer') %>
