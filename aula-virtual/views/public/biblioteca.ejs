<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Biblioteca — Aula Virtual</title>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="min-h-screen bg-bg">
    <%
        // Tailwind necesita ver la clase completa escrita en algún
        // lado para generarla — por eso el mapeo es explícito acá en
        // vez de armar el nombre de la clase con un template string.
        const colorClasses = {
            violet: 'bg-violet-200 text-violet-800',
            pink: 'bg-pink-200 text-pink-800',
            amber: 'bg-amber-200 text-amber-800',
            orange: 'bg-orange-200 text-orange-800',
        };
        const colorRing = {
            violet: 'ring-violet-500',
            pink: 'ring-pink-500',
            amber: 'ring-amber-500',
            orange: 'ring-orange-500',
        };
    %>

    <header class="border-b border-ink-900/10 bg-white/60">
        <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
            <h1 class="text-2xl font-extrabold text-green-800">Biblioteca</h1>
            <p class="text-sm text-ink-600">Hola, <span class="font-semibold"><%= childName %></span></p>
        </div>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-8">
        <div class="flex flex-wrap items-center gap-4">
            <a href="/biblioteca<%= busqueda ? '?q=' + encodeURIComponent(busqueda) : '' %>"
                class="flex flex-col items-center gap-1.5 <%= !filtroSubject ? 'opacity-100' : 'opacity-70 hover:opacity-100' %>">
                <span class="flex h-16 w-16 items-center justify-center rounded-full bg-ink-900/5 text-2xl ring-2 <%= !filtroSubject ? 'ring-ink-900/40' : 'ring-transparent' %>">
                    📚
                </span>
                <span class="text-xs font-semibold text-ink-600">Todo</span>
            </a>

            <% subjects.forEach(subject => { %>
                <a href="/biblioteca?materia=<%= subject.id %><%= busqueda ? '&q=' + encodeURIComponent(busqueda) : '' %>"
                    class="flex flex-col items-center gap-1.5 <%= filtroSubject === subject.id ? 'opacity-100' : 'opacity-70 hover:opacity-100' %>">
                    <span class="flex h-16 w-16 items-center justify-center rounded-full text-2xl ring-2 <%= colorClasses[subject.color] %> <%= filtroSubject === subject.id ? colorRing[subject.color] : 'ring-transparent' %>">
                        <%= subject.icon %>
                    </span>
                    <span class="text-xs font-semibold text-ink-600"><%= subject.name %></span>
                </a>
            <% }) %>
        </div>

        <form method="GET" action="/biblioteca" class="mt-6 flex gap-2">
            <% if (filtroSubject) { %><input type="hidden" name="materia" value="<%= filtroSubject %>"><% } %>
            <input type="search" name="q" value="<%= busqueda %>" placeholder="Buscar por título..."
                class="w-full max-w-sm rounded-lg border border-ink-900/15 px-3 py-2 text-sm">
            <button type="submit" class="rounded-lg bg-green-800 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700">
                Buscar
            </button>
        </form>

        <% if (!filtroSubject) { %>
            <h2 class="mt-8 text-lg font-bold text-ink-900">Todo lo nuevo</h2>
            <%- include('_tarjetas-contenido', { items, mensajeVacio: busqueda ? 'No encontramos nada con ese título.' : 'Todavía no hay nada acá. ¡Pronto va a haber cuentos y videos!' }) %>
        <% } else { %>
            <% modulosConItems.forEach(modulo => { %>
                <h2 class="mt-8 text-lg font-bold text-ink-900"><%= modulo.name %></h2>
                <%- include('_tarjetas-contenido', { items: modulo.items, mensajeVacio: '' }) %>
            <% }) %>

            <% if (itemsSinModulo.length > 0) { %>
                <h2 class="mt-8 text-lg font-bold text-ink-900"><%= modulosConItems.length > 0 ? 'Otros' : subjects.find(s => s.id === filtroSubject)?.name %></h2>
                <%- include('_tarjetas-contenido', { items: itemsSinModulo, mensajeVacio: '' }) %>
            <% } %>

            <% if (modulosConItems.length === 0 && itemsSinModulo.length === 0) { %>
                <p class="mt-6 rounded-2xl bg-white p-8 text-center text-ink-600 shadow-card">
                    <%= busqueda ? 'No encontramos nada con ese título.' : 'Todavía no hay nada acá. ¡Pronto va a haber cuentos y videos!' %>
                </p>
            <% } %>
        <% } %>
    </main>
</body>
</html>
