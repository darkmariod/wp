<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>¿Quién sos? — Aula Virtual</title>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="flex min-h-screen items-center justify-center bg-bg">
    <div class="text-center">
        <h1 class="text-3xl font-bold text-green-800">¿Quién va a jugar hoy?</h1>

        <% if (children.length === 0) { %>
            <p class="mt-6 text-ink-600">Todavía no hay ningún perfil cargado. Pedile a tu docente que te agregue.</p>
        <% } else { %>
            <div class="mt-10 flex flex-wrap justify-center gap-6">
                <% children.forEach(child => { %>
                    <form method="POST" action="/elegir/<%= child.id %>">
                        <button type="submit" class="group flex w-32 flex-col items-center gap-2">
                            <% if (child.avatar_path) { %>
                                <img src="<%= child.avatar_path %>"
                                    class="h-24 w-24 rounded-full border-4 border-white object-cover shadow-card transition-transform group-hover:scale-105 group-hover:shadow-card-hover">
                            <% } else { %>
                                <div class="flex h-24 w-24 items-center justify-center rounded-full border-4 border-white bg-green-100 text-4xl shadow-card transition-transform group-hover:scale-105 group-hover:shadow-card-hover">🙂</div>
                            <% } %>
                            <span class="text-lg font-semibold text-ink-900"><%= child.name %></span>
                        </button>
                    </form>
                <% }) %>
            </div>
        <% } %>
    </div>
</body>
</html>
