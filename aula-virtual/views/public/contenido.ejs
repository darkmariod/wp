<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= item.title %> — Aula Virtual</title>
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="min-h-screen bg-bg">
    <header class="border-b border-ink-900/10 bg-white/60">
        <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
            <a href="/biblioteca" class="flex items-center gap-2 text-sm font-semibold text-green-800 hover:text-green-900">
                <span aria-hidden="true">←</span> Biblioteca
            </a>
            <p class="text-sm text-ink-600">Hola, <span class="font-semibold"><%= childName %></span></p>
        </div>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-8">
        <p class="text-xs font-semibold uppercase tracking-wide text-violet-600">
            <%= item.type === 'video' ? 'Video' : item.type === 'activity' ? 'Actividad' : 'Cuento' %>
            <% if (item.subject_name) { %> · <%= item.subject_name %><% } %>
        </p>
        <h1 class="mt-1 text-3xl font-extrabold text-ink-900"><%= item.title %></h1>
        <% if (item.description) { %>
            <p class="mt-3 text-ink-600"><%= item.description %></p>
        <% } %>

        <div class="mt-6">
            <% if (item.type === 'video') { %>
                <video
                    src="<%= item.file_path %>"
                    controls
                    playsinline
                    poster="<%= item.cover_path || '' %>"
                    class="w-full rounded-2xl bg-black shadow-card"
                >
                    Tu navegador no puede reproducir este video.
                </video>

            <% } else if (item.type === 'book') { %>
                <div id="lector-cuento" class="relative overflow-hidden rounded-2xl bg-white shadow-card">
                    <% paginas.forEach((pagina, indice) => { %>
                        <img
                            src="<%= pagina.image_path %>"
                            alt="Página <%= indice + 1 %>"
                            class="lector-cuento__pagina w-full<%= indice === 0 ? '' : ' hidden' %>"
                        >
                    <% }) %>

                    <div class="flex items-center justify-between gap-4 border-t border-ink-900/10 bg-white p-4">
                        <button type="button" data-lector-anterior class="flex h-11 w-11 items-center justify-center rounded-full bg-green-50 text-xl text-green-800 disabled:opacity-30">←</button>
                        <span class="text-sm font-medium text-ink-600">
                            Página <span data-lector-numero>1</span> de <%= paginas.length %>
                        </span>
                        <button type="button" data-lector-siguiente class="flex h-11 w-11 items-center justify-center rounded-full bg-green-50 text-xl text-green-800 disabled:opacity-30">→</button>
                    </div>
                </div>

                <script>
                    (function () {
                        var lector = document.getElementById('lector-cuento');
                        var paginas = lector.querySelectorAll('.lector-cuento__pagina');
                        var botonAnterior = lector.querySelector('[data-lector-anterior]');
                        var botonSiguiente = lector.querySelector('[data-lector-siguiente]');
                        var numero = lector.querySelector('[data-lector-numero]');
                        var actual = 0;

                        function mostrar(indice) {
                            paginas[actual].classList.add('hidden');
                            actual = indice;
                            paginas[actual].classList.remove('hidden');
                            numero.textContent = actual + 1;
                            botonAnterior.disabled = actual === 0;
                            botonSiguiente.disabled = actual === paginas.length - 1;
                        }

                        botonAnterior.disabled = true;
                        botonSiguiente.disabled = paginas.length <= 1;
                        botonAnterior.addEventListener('click', function () { if (actual > 0) mostrar(actual - 1); });
                        botonSiguiente.addEventListener('click', function () { if (actual < paginas.length - 1) mostrar(actual + 1); });
                    })();
                </script>

            <% } else if (item.cover_path) { %>
                <div class="rounded-2xl bg-white p-6 shadow-card">
                    <img src="<%= item.cover_path %>" alt="" class="w-full rounded-xl">
                </div>
            <% } else if (!item.description) { %>
                <div class="rounded-2xl bg-white p-6 shadow-card">
                    <p class="text-ink-600">Pedile a tu docente que te cuente de qué se trata esta actividad.</p>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>
