---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fab from '../components/Fab.astro';
import { traerConfiguracion } from '../sanity/consultas';

// Astro con inlineStylesheets:'always' mete este CSS en un <style>
// dentro del documento en el build — es la razón real por la que ya
// no existe el destello de "HTML sin estilos" al navegar (antes lo
// hacía a mano scripts/build.mjs, concatenando estos mismos archivos).
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/componentes.css';
import '../styles/animaciones.css';

interface Props {
  title: string;
  description: string;
  ogTitle: string;
  ogDescription: string;
  ogImage: string;
  canonicalPath: string;
  current: 'inicio' | 'nosotros' | 'galeria' | 'contacto';
  ctaContacto?: boolean;
  preloadImage?: string;
  conJsonLd?: boolean;
  datosGaleria?: Record<string, string>;
}

const {
  title, description, ogTitle, ogDescription, ogImage,
  canonicalPath, current, ctaContacto = true, preloadImage,
  conJsonLd = false, datosGaleria,
} = Astro.props;

// Los datos del colegio se leen una sola vez acá y bajan a los tres
// componentes: así el teléfono vive en un único lugar del CMS y no hay
// forma de que el pie y el botón flotante queden diciendo cosas
// distintas.
const config = await traerConfiguracion();

const sitio = 'https://pestalozzi-opal.vercel.app';
const canonical = canonicalPath === '/' ? `${sitio}/` : `${sitio}${canonicalPath}`;
const imagenAbsoluta = ogImage.startsWith('http') ? ogImage : `${sitio}${ogImage}`;

// Lo que main.js necesita saber del CMS. Va como JSON y no como
// atributos sueltos para no repetir el mismo dato en varios lugares.
const datosSitio = {
  whatsapp: config.telefonoInternacional,
  ...(datosGaleria ? { galeria: datosGaleria } : {}),
};

const jsonLd = conJsonLd
  ? {
      '@context': 'https://schema.org',
      '@type': 'EducationalOrganization',
      name: 'Unidad Educativa Pestalozzi Ambato',
      alternateName: 'Mi escuelita Pestalozzi',
      description,
      telephone: `+${config.telefonoInternacional}`,
      email: config.correo,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${config.direccionCalle}, ${config.direccionSector}`,
        addressLocality: config.ciudad,
        addressCountry: 'EC',
      },
      sameAs: [config.facebook, config.tiktok].filter(Boolean),
    }
  : null;
---
<!DOCTYPE html>
<html lang="es-EC">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline>document.documentElement.classList.add('js')</script>
<title>{title}</title>
<meta name="description" content={description}>

<meta property="og:type" content="website">
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={imagenAbsoluta}>
<meta property="og:locale" content="es_EC">
<meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={imagenAbsoluta}>

<link rel="canonical" href={canonical}>
<link rel="icon" href="/img/marca/logo.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"></noscript>
{preloadImage && <link rel="preload" as="image" href={preloadImage}>}

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
)}
</head>
<body>

<script type="application/json" id="datos-sitio" set:html={JSON.stringify(datosSitio)} />

<a class="saltar" href="#principal">Saltar al contenido</a>

<Header current={current} ctaContacto={ctaContacto} config={config} />

<main id="principal">
  <slot />
</main>

<Footer config={config} />
<Fab config={config} />

<script src="/js/main.js" defer></script>
</body>
</html>
