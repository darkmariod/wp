---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Página no encontrada | Unidad Educativa Pestalozzi Ambato"
  description="La página que buscás no existe."
  ogTitle="Página no encontrada"
  ogDescription="La página que buscás no existe."
  ogImage="/img/marca/logo.png"
  canonicalPath="/404"
  current="inicio"
  locale="es"
>
  <section class="seccion seccion--clara pagina-404">
    <div class="contenedor pagina-404__contenido">
      <span class="eyebrow">404</span>
      <h1>Este sendero todavía no existe.</h1>
      <p>La página que buscás no está acá. Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <a href="/" class="btn btn--primario">Volver a Mi escuelita</a>
    </div>
  </section>
</Layout>
