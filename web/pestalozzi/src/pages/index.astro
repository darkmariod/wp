---
import Layout from '../layouts/Layout.astro';
import Franja from '../components/Franja.astro';
import SplitText from '../components/reactbits/SplitText.jsx';
import FadeContent from '../components/reactbits/FadeContent.jsx';
import AnimatedContent from '../components/reactbits/AnimatedContent.jsx';
import ScrollReveal from '../components/reactbits/ScrollReveal.jsx';
import ProgramaTarjeta from '../components/reactbits/ProgramaTarjeta.jsx';
import DepthCarousel from '../components/reactbits/DepthCarousel.jsx';
import { traerConfiguracion, traerFotos, traerInicio } from '../sanity/consultas';
import { dimensiones, urlImagen } from '../sanity/imagen';

const p = await traerInicio();
const config = await traerConfiguracion();
const whatsapp = `https://wa.me/${config.telefonoInternacional}`;

const medidasTarjeta = (img: any) => dimensiones(img, 640);

// Videos de portada: los del CMS mandan; si el colegio no subió ninguno
// quedan los que ya venían con el sitio. Así nunca se queda sin video
// por un campo vacío, y el colegio puede cambiarlo sin tocar código.
const videoEscritorio = p.videoEscritorio || '/img/hero/hero-escritorio.mp4';
const videoMovil = p.videoMovil || p.videoEscritorio || '/img/hero/hero-movil.mp4';

// El carrusel necesita 4 fotos o más para que se note la profundidad, y
// esta sección solo tiene dos. Si el colegio no cargó las suyas, se
// usan las de la galería: son fotos reales del plantel, no relleno.
const fotosCarrusel = (
  p.nivelesCarrusel?.length >= 3
    ? p.nivelesCarrusel
    : (await traerFotos()).map((f: any) => f.imagen)
).map((img: any) => ({
  image: urlImagen(img, 600),
  alt: img.alt,
  ...dimensiones(img, 600),
}));
---
<Layout
  title="Unidad Educativa Pestalozzi Ambato | Matrículas 2026 – 2027"
  description="Escuela en Ambato con la filosofía Pestalozzi: el niño en el centro de su aprendizaje. Matrículas abiertas ciclo 2026 – 2027."
  ogTitle="Unidad Educativa Pestalozzi Ambato"
  ogDescription={p.bajada}
  ogImage={urlImagen(p.fotoPortada, 1200)}
  canonicalPath="/"
  current="inicio"
  preloadImage={urlImagen(p.fotoPortada, 720)}
  conJsonLd
>
  <!-- ============ PORTADA ============ -->
  <section class="hero" data-anim="react">
    <img class="hero__foto" src={urlImagen(p.fotoPortada, 720)} alt={p.fotoPortada.alt} width="720" height="1280" fetchpriority="high">
    <video class="hero__video" autoplay muted loop playsinline preload="none" poster={urlImagen(p.fotoPortada, 720)} aria-hidden="true" tabindex="-1">
      <source src={videoEscritorio} media="(min-width: 1024px)">
      <source src={videoMovil}>
    </video>
    <div class="hero__velo"></div>
    <div class="contenedor hero__contenido">
      <h1 class="hero__titulo">
        <SplitText
          text={p.tituloLinea1}
          tag="span"
          className="hero__titulo--texto"
          splitType="words"
          delay={40}
          duration={0.7}
          from={{ opacity: 0, y: 24 }}
          to={{ opacity: 1, y: 0 }}
          client:visible
        />
        <br />
        <SplitText
          text={p.tituloLinea2}
          tag="span"
          className="hero__titulo--texto hero__titulo--acento"
          splitType="words"
          delay={40}
          duration={0.7}
          from={{ opacity: 0, y: 24 }}
          to={{ opacity: 1, y: 0 }}
          client:visible
        />
      </h1>
      <FadeContent duration={600} delay={100} threshold={0.1} client:visible>
        <p class="hero__bajada">{p.bajada}</p>
      </FadeContent>
      <FadeContent duration={600} delay={250} threshold={0.1} client:visible>
        <div class="hero__acciones">
          <a href="/contacto" class="btn btn--primario">Agenda tu visita</a>
          <a href="/nosotros" class="enlace-flecha">Conoce la propuesta</a>
        </div>
      </FadeContent>
    </div>
    <a href="#propuesta" class="bajar" aria-label="Ir al contenido">
      <span>Desliza</span>
      <span class="bajar__linea"></span>
    </a>
  </section>

  <!-- ============ LO QUE NOS DISTINGUE ============
       Va apenas debajo de la portada, como la fila de razones de la
       referencia que dio el colegio: lo primero que ve un padre después
       del título, antes de entrar en la filosofía. -->
  {p.destacados?.length > 0 && (
    <section class="destacados-franja">
      <div class="contenedor">
        <ul class="destacados">
          {p.destacados.map((d: any, i: number) => (
            <AnimatedContent distance={24} duration={0.5} delay={i * 0.08} threshold={0.15} client:visible>
              <li class="destacado">
                <h3>{d.titulo}</h3>
                <p>{d.texto}</p>
              </li>
            </AnimatedContent>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ============ PROPUESTA ============ -->
  <section class="seccion seccion--clara" id="propuesta">
    <div class="contenedor">
      <div class="enc-partido" data-revelar>
        <h2>{p.propuestaTitulo}</h2>
        <p>{p.propuestaTexto}</p>
      </div>

      <div class="pilares">
        {p.propuestaPilares.map((pilar: any, i: number) => (
          <AnimatedContent distance={40} duration={0.6} delay={i * 0.12} threshold={0.2} client:visible>
            <article class="pilar-tarjeta">
              <span class="pilar-tarjeta__numero">{String(i + 1).padStart(2, '0')}</span>
              <h3>{pilar.titulo}</h3>
              <p>{pilar.texto}</p>
            </article>
          </AnimatedContent>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ NIVELES ============ -->
  <section class="seccion seccion--suave" id="niveles">
    <div class="contenedor">
      <div class="enc-seccion enc-seccion--izq" data-revelar>
        <span class="eyebrow">{p.nivelesEyebrow}</span>
        <h2>{p.nivelesTitulo}</h2>
        <p>{p.nivelesTexto}</p>
        <ul class="niveles-chips">
          {p.nivelesChips.map((chip: string, i: number) => (
            <li class="niveles-chips__item" data-revelar="zoom" data-retraso={i > 0 ? i * 60 : undefined}>{chip}</li>
          ))}
        </ul>
      </div>

      {/* Carrusel de profundidad en lugar del mosaico. Los dos bloques
          de color bajan debajo: llevan contenido real del CMS y enlazan
          a contacto, así que no se pierden.

          client:load, no client:visible: el carrusel posiciona cada
          tarjeta por JavaScript. Sin hidratar quedan las seis apiladas
          en el centro, que se ve roto — no es "sin animar", es mal. */}
      <div class="niveles-carrusel">
        <DepthCarousel
          items={fotosCarrusel}
          cardWidth={300}
          cardHeight={380}
          depth={200}
          spread={80}
          tilt={20}
          visibleCards={4}
          falloff={0.18}
          blur={5}
          tint="#0B4A26"
          autoplay
          autoplayDelay={4000}
          loop
          client:load
        />
      </div>

      <div class="niveles-bloques">
        <a href="/contacto" class="niveles-mosaico__bloque niveles-mosaico__bloque--verde" data-revelar="der">
          <h3>{p.nivelesBloqueVerde.titulo}</h3>
          <p>{p.nivelesBloqueVerde.texto}</p>
          <span class="niveles-mosaico__flecha" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/contacto" class="niveles-mosaico__bloque niveles-mosaico__bloque--ambar" data-revelar="izq">
          <h3>{p.nivelesBloqueAmbar.titulo}</h3>
          <p>{p.nivelesBloqueAmbar.texto}</p>
          <span class="niveles-mosaico__flecha" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ QUÉ OFRECE CADA NIVEL ============
       Solo aparece si el colegio cargó los niveles en el CMS: sin datos
       reales de edades y cupos, es preferible que no exista a que
       muestre información inventada que un padre podría usar. -->
  {p.programas?.length > 0 && (
    <section class="seccion seccion--clara" id="programas">
      <div class="contenedor">
        <div class="enc-seccion" data-revelar>
          <h2>{p.programasTitulo}</h2>
          {p.programasTexto && <p>{p.programasTexto}</p>}
        </div>

        <div class="programas">
          {p.programas.map((prog: any, i: number) => (
            <ProgramaTarjeta programa={prog} indice={i} client:visible />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ DATOS PRÁCTICOS ============ -->
  {p.practicoDatos?.length > 0 && (
    <section class="seccion seccion--suave">
      <div class="contenedor">
        <div class="enc-seccion" data-revelar>
          <h2>{p.practicoTitulo}</h2>
        </div>
        <dl class="datos-practicos">
          {p.practicoDatos.map((dato: any, i: number) => (
            <AnimatedContent distance={30} duration={0.5} delay={i * 0.08} threshold={0.15} client:visible>
              <div class="dato-practico">
                <dt>{dato.etiqueta}</dt>
                <dd>{dato.valor}</dd>
                {dato.detalle && <p class="dato-practico__detalle">{dato.detalle}</p>}
              </div>
            </AnimatedContent>
          ))}
        </dl>
      </div>
    </section>
  )}

  <!-- ============ MARQUESINA ============ -->
  <!-- Las frases se duplican porque la animación desplaza -50%: así el
       bucle empalma sin salto. -->
  <section class="marquesina" aria-hidden="true">
    <div class="marquesina__pista">
      {[...p.marquesinaFrases, ...p.marquesinaFrases].map((frase: string) => (
        <span class="marquesina__item">{frase}<span>&bull;</span></span>
      ))}
    </div>
  </section>

  <!-- ============ POR QUÉ ============ -->
  <section class="seccion seccion--clara seccion--compacta">
    <div class="contenedor partido">
      <div class="partido__foto" data-revelar="izq" data-cortina="izq">
        <img src={urlImagen(p.porQueFoto, 640)} alt={p.porQueFoto.alt} {...medidasTarjeta(p.porQueFoto)} loading="lazy">
      </div>
      <div class="partido__texto" data-revelar="der">
        <span class="eyebrow">{p.porQueEyebrow}</span>
        <ScrollReveal text={p.porQueTitulo} containerClassName="porque__titulo" client:visible />
        {p.porQueParrafos.map((parrafo: string) => <p>{parrafo}</p>)}
        <p class="mt-8">
          <a href="/nosotros" class="btn btn--secundario">Conócenos</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ GALERÍA ============ -->
  <section class="seccion seccion--clara seccion--amplia">
    <div class="contenedor">
      <div class="enc-numerado" data-revelar>
        <span>{p.galeriaEyebrow}</span>
        <h2>{p.galeriaTitulo}</h2>
        <p>{p.galeriaTexto}</p>
      </div>

      <div class="galeria-mini">
        {[p.franja.foto, p.nivelesFotoIzquierda, p.porQueFoto].map((foto: any, i: number) => (
          <a class="galeria-mini__item" href="/galeria">
            <img src={urlImagen(foto, 640)} alt={foto.alt} {...medidasTarjeta(foto)} loading="lazy" data-revelar data-retraso={i > 0 ? i * 100 : undefined}>
          </a>
        ))}
      </div>

      <p class="centro" style="margin-top:var(--space-12)" data-revelar>
        <a href="/galeria" class="btn btn--secundario">Ver toda la galería</a>
      </p>
    </div>
  </section>

  <Franja franja={p.franja} whatsapp={whatsapp} />
</Layout>
