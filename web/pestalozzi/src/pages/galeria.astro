---
import Layout from '../layouts/Layout.astro';
import Franja from '../components/Franja.astro';
import GaleriaMasonry from '../components/reactbits/GaleriaMasonry.jsx';
import { traerConfiguracion, traerFotos, traerGaleria } from '../sanity/consultas';
import { dimensiones, urlImagen } from '../sanity/imagen';

const p = await traerGaleria();
const fotos = await traerFotos();
const config = await traerConfiguracion();
const whatsapp = `https://wa.me/${config.telefonoInternacional}`;

const FILTROS = [
  { valor: 'todas', texto: 'Todas' },
  { valor: 'instalaciones', texto: 'Instalaciones' },
  { valor: 'actividades', texto: 'Actividades' },
  { valor: 'deportes', texto: 'Deportes' },
  { valor: 'eventos', texto: 'Eventos' },
];

// main.js las usa para cambiar el texto al tocar cada filtro.
const descripciones = {
  todas: p.descTodas,
  instalaciones: p.descInstalaciones,
  actividades: p.descActividades,
  deportes: p.descDeportes,
  eventos: p.descEventos,
};

const plural = (n: number) => `${n} ${n === 1 ? 'fotografía' : 'fotografías'}`;

const fotosMasonry = fotos.map((f: any) => ({
  id: f._id ?? f.imagen?.asset?._ref,
  url: urlImagen(f.imagen, 500),
  alto: dimensiones(f.imagen, 500).height ?? 500,
  alt: f.imagen.alt,
  categoria: f.categoria,
}));
---
<Layout
  title="Galería | Unidad Educativa Pestalozzi Ambato"
  description="Instalaciones, actividades, deportes y eventos de la Unidad Educativa Pestalozzi de Ambato."
  ogTitle="Galería | Pestalozzi Ambato"
  ogDescription={p.portada.bajada}
  ogImage={urlImagen(p.portada.foto, 1200)}
  canonicalPath="/galeria"
  current="galeria"
  preloadImage={urlImagen(p.portada.foto, 720)}
  datosGaleria={descripciones}
>
  <section class="hero hero--interior">
    <img class="hero__foto" src={urlImagen(p.portada.foto, 720)} alt={p.portada.foto.alt} width="720" height="1280" fetchpriority="high">
    <div class="hero__velo"></div>
    <div class="contenedor hero__contenido">
      <p class="hero__migas"><a href="/">Inicio</a> / Galería</p>
      <h1 class="hero__titulo">{p.portada.titulo}</h1>
      <p class="hero__bajada">{p.portada.bajada}</p>
    </div>
  </section>

  <section class="seccion seccion--clara">
    <div class="contenedor">

      {/* client:load, no client:visible: Masonry no calcula su grid en
          el servidor (depende de medir el ancho real en el navegador),
          así que sin hidratación inmediata esta sección queda vacía —
          a diferencia de SplitText/FadeContent, que sí muestran el
          contenido real antes de animar. */}
      <GaleriaMasonry fotos={fotosMasonry} descripciones={descripciones} client:load />

    </div>
  </section>

  <Franja franja={p.franja} whatsapp={whatsapp} />
</Layout>
