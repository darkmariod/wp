---
import Layout from '../layouts/Layout.astro';
import Franja from '../components/Franja.astro';
import { traerConfiguracion, traerFotos, traerGaleria } from '../sanity/consultas';
import { dimensiones, urlImagen } from '../sanity/imagen';

const p = await traerGaleria();
const fotos = await traerFotos();
const config = await traerConfiguracion();
const whatsapp = `https://wa.me/${config.telefonoInternacional}`;

// El acordeon pide "image"; "grande" es la version para el visor.
const fotosAcordeon = fotos.map((f: any) => ({
  id: f._id ?? f.imagen?.asset?._ref,
  image: urlImagen(f.imagen, 900),
  grande: urlImagen(f.imagen, 1600),
  label: f.imagen.alt,
  alt: f.imagen.alt,
  // width/height reales para que el navegador reserve el espacio y la
  // página no salte mientras cargan las fotos (CLS).
  ...dimensiones(f.imagen, 900),
}));
---
<Layout
  title="Galería | Unidad Educativa Pestalozzi Ambato"
  description="Instalaciones, actividades, deportes y eventos de la Unidad Educativa Pestalozzi de Ambato."
  ogTitle="Galería | Pestalozzi Ambato"
  ogDescription={p.portada.bajada}
  ogImage={urlImagen(p.portada.foto, 1200)}
  canonicalPath="/galeria"
  current="galeria"
  preloadImage={urlImagen(p.portada.foto, 720)}
>
  <section class="hero hero--interior">
    <img class="hero__foto" src={urlImagen(p.portada.foto, 720)} alt={p.portada.foto.alt} width="720" height="1280" fetchpriority="high">
    <div class="hero__velo"></div>
    <div class="contenedor hero__contenido">
      <p class="hero__migas"><a href="/">Inicio</a> / Galería</p>
      <h1 class="hero__titulo">{p.portada.titulo}</h1>
      <p class="hero__bajada">{p.portada.bajada}</p>
    </div>
  </section>

  <section class="seccion seccion--clara">
    <div class="contenedor">

      <p class="galeria-desc">{p.descTodas}</p>

      <p class="centro" style="color:var(--ink-400);margin-bottom:var(--space-8)">
        {fotosAcordeon.length} fotografías<span class="galeria-pista"> · tocá una foto para ampliarla</span>
      </p>

      {/* El acordeón lo mueve GSAP desde componentes.js. El HTML llega
          completo desde el servidor: sin JavaScript se ven igual las
          seis fotos, solo que sin la expansión. */}
      <div class="acordeon" data-acordeon>
        {fotosAcordeon.map((f: any) => (
          <div class="acordeon__panel" role="button" tabindex="0"
               data-grande={f.grande} aria-label={`Ampliar: ${f.alt}`}>
            <span class="acordeon__marco">
              <span class="acordeon__medio">
                <img src={f.image} alt={f.alt} width={f.width} height={f.height} loading="lazy" draggable="false">
              </span>
              <span class="acordeon__velo" aria-hidden="true"></span>
            </span>
            <span class="acordeon__etiqueta" aria-hidden="true">
              <span class="acordeon__barra"></span>
              <span class="acordeon__texto">{f.alt}</span>
            </span>
          </div>
        ))}
      </div>

      <div class="lightbox" role="dialog" aria-modal="true" aria-label="Fotografía ampliada" aria-hidden="true">
        <button class="lightbox__btn lightbox__cerrar" aria-label="Cerrar">&times;</button>
        <button class="lightbox__btn lightbox__ant" aria-label="Anterior">&#8249;</button>
        {/* Vacía hasta que se abre: la llena componentes.js con la
            foto elegida. aria-hidden para que el lector no anuncie una
            imagen que todavía no existe. */}
        <img src="" alt="" aria-hidden="true">
        <button class="lightbox__btn lightbox__sig" aria-label="Siguiente">&#8250;</button>
        <p class="lightbox__cuenta"></p>
      </div>

    </div>
  </section>

  <Franja franja={p.franja} whatsapp={whatsapp} />
</Layout>
