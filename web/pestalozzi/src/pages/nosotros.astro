---
import Layout from '../layouts/Layout.astro';
import Franja from '../components/Franja.astro';
import BlurText from '../components/reactbits/BlurText.jsx';
import AnimatedContent from '../components/reactbits/AnimatedContent.jsx';
import { traerConfiguracion, traerNosotros } from '../sanity/consultas';
import { dimensiones, urlImagen } from '../sanity/imagen';

const p = await traerNosotros();
const config = await traerConfiguracion();
const whatsapp = `https://wa.me/${config.telefonoInternacional}`;
---
<Layout
  title="Nosotros | Unidad Educativa Pestalozzi Ambato"
  description="Quiénes somos, la filosofía Pestalozzi en el aula, misión y visión de la Unidad Educativa Pestalozzi de Ambato."
  ogTitle="Nosotros | Pestalozzi Ambato"
  ogDescription={p.portada.bajada}
  ogImage={urlImagen(p.portada.foto, 1200)}
  canonicalPath="/nosotros"
  current="nosotros"
  preloadImage={urlImagen(p.portada.foto, 720)}
>
  <section class="hero hero--interior" data-anim="react-titulo">
    <img class="hero__foto" src={urlImagen(p.portada.foto, 720)} alt={p.portada.foto.alt} width="720" height="1280" fetchpriority="high">
    <div class="hero__velo"></div>
    <div class="contenedor hero__contenido">
      <p class="hero__migas"><a href="/">Inicio</a> / Nosotros</p>
      <h1 class="hero__titulo"><BlurText text={p.portada.titulo} animateBy="words" direction="top" client:visible /></h1>
      <p class="hero__bajada">{p.portada.bajada}</p>
    </div>
  </section>

  <!-- ============ QUIÉNES SOMOS ============ -->
  <section class="seccion seccion--clara">
    <div class="contenedor partido partido--texto-primero">
      <div class="partido__texto" data-revelar="izq">
        <span class="eyebrow">{p.quienesEyebrow}</span>
        <h2>{p.quienesTitulo}</h2>
        {p.quienesParrafos.map((parrafo: string) => <p>{parrafo}</p>)}
      </div>
      <div class="partido__foto" data-revelar="der" data-cortina="der">
        <img src={urlImagen(p.quienesFoto, 640)} alt={p.quienesFoto.alt} {...dimensiones(p.quienesFoto, 640)} loading="lazy">
      </div>
    </div>
  </section>

  <!-- ============ FILOSOFÍA ============ -->
  <section class="seccion seccion--suave">
    <div class="contenedor">
      <div class="enc-seccion" data-revelar>
        <span class="eyebrow">{p.filosofiaEyebrow}</span>
        <h2>{p.filosofiaTitulo}</h2>
        <p>{p.filosofiaTexto}</p>
      </div>

      <div class="pilares">
        {p.filosofiaPilares.map((pilar: any, i: number) => (
          <AnimatedContent distance={40} duration={0.6} delay={i * 0.12} threshold={0.2} client:visible>
            <article class="pilar-tarjeta">
              <span class="pilar-tarjeta__numero">{String(i + 1).padStart(2, '0')}</span>
              <h3>{pilar.titulo}</h3>
              <p>{pilar.texto}</p>
            </article>
          </AnimatedContent>
        ))}
      </div>
    </div>
  </section>

  <Franja franja={p.franja} whatsapp={whatsapp}>
    <a href="/contacto" class="enlace-flecha">Ver datos de contacto</a>
  </Franja>
</Layout>
