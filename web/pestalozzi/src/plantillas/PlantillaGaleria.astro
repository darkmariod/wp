---
import Layout from '../layouts/Layout.astro';
import Franja from '../components/Franja.astro';
import { traerConfiguracion, traerFotos, traerGaleria } from '../sanity/consultas';
import { dimensiones, urlImagen } from '../sanity/imagen';
import { t, urlIdioma, UI, type Locale } from '../sanity/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = UI[locale];
const uiG = ui.galeria;

const p = await traerGaleria();
const fotos = await traerFotos();
const config = await traerConfiguracion();
const whatsapp = `https://wa.me/${config.telefonoInternacional}`;

// La grilla pide "image"; "grande" es la versión para el visor. El
// alt de la foto queda compartido entre los dos idiomas a propósito
// (ver la nota en schemaTypes/objetos.ts) — no hace falta t() acá.
// categoria y ambiente alimentan el filtro doble (un mismo valor basta:
// los textos visibles de los filtros vienen de i18n, estos valores son
// los internos que compara el JS).
const fotosGrilla = fotos.map((f: any) => ({
  id: f._id ?? f.imagen?.asset?._ref,
  image: urlImagen(f.imagen, 900),
  grande: urlImagen(f.imagen, 1600),
  alt: f.imagen.alt,
  categoria: f.categoria,
  ambiente: f.ambiente ?? '',
  ...dimensiones(f.imagen, 900),
}));

// Opciones de las dos filas de filtros. "todas" es el valor por defecto
// de ambas filas: el JS combina ambiente + categoria con un AND.
const ambientes = [
  { valor: 'todas', label: uiG.filtroTodas },
  { valor: 'mentes-absorbentes', label: uiG.filtroMentesAbsorbentes },
  { valor: 'mentes-razonadoras', label: uiG.filtroMentesRazonadoras },
];
const categorias = [
  { valor: 'todas', label: uiG.filtroTodasFotos },
  { valor: 'instalaciones', label: uiG.filtroInstalaciones },
  { valor: 'actividades', label: uiG.filtroActividades },
  { valor: 'deportes', label: uiG.filtroDeportes },
  { valor: 'eventos', label: uiG.filtroEventos },
];
const descs = [
  { valor: 'todas', texto: t(p.descTodas, locale) },
  { valor: 'instalaciones', texto: t(p.descInstalaciones, locale) },
  { valor: 'actividades', texto: t(p.descActividades, locale) },
  { valor: 'deportes', texto: t(p.descDeportes, locale) },
  { valor: 'eventos', texto: t(p.descEventos, locale) },
];
---
<Layout
  title={uiG.tituloPagina}
  description={uiG.descripcionPagina}
  ogTitle={uiG.tituloPagina}
  ogDescription={t(p.portada.bajada, locale)}
  ogImage={urlImagen(p.portada.foto, 1200)}
  canonicalPath={urlIdioma('/galeria', locale)}
  current="galeria"
  preloadImage={urlImagen(p.portada.foto, 720)}
  locale={locale}
  bilingue={true}
>
  <section class="hero hero--interior">
    <img class="hero__foto" src={urlImagen(p.portada.foto, 720)} alt={p.portada.foto.alt} width="720" height="1280" fetchpriority="high">
    <div class="hero__velo"></div>
    <div class="contenedor hero__contenido">
      <p class="hero__migas"><a href={urlIdioma('/', locale)}>{ui.breadcrumbInicio}</a> / {ui.nav.galeria}</p>
      <h1 class="hero__titulo">{t(p.portada.titulo, locale)}</h1>
      <p class="hero__bajada">{t(p.portada.bajada, locale)}</p>
    </div>
  </section>

  <section class="seccion seccion--clara">
    <div class="contenedor">

      <div class="galeria-filtros" role="group" aria-label={uiG.filtrosAmbiente}>
        <p class="galeria-filtros__label">{uiG.filtrosAmbiente}</p>
        <div class="filtros">
          {ambientes.map((a) => (
            <button class="filtro" data-ambiente={a.valor}
                    aria-pressed={a.valor === 'todas'}>
              {a.label}
            </button>
          ))}
        </div>
      </div>

      <div class="galeria-filtros" role="group" aria-label={uiG.filtrosCategoria}>
        <p class="galeria-filtros__label">{uiG.filtrosCategoria}</p>
        <div class="filtros">
          {categorias.map((c) => (
            <button class="filtro" data-categoria={c.valor}
                    aria-pressed={c.valor === 'todas'}>
              {c.label}
            </button>
          ))}
        </div>
      </div>

      <p class="galeria-desc" data-desc-inicial={t(p.descTodas, locale)}>
        {t(p.descTodas, locale)}
      </p>

      <p class="centro" style="color:var(--ink-400);margin-bottom:var(--space-8)">
        <span class="galeria-contador" data-total={fotos.length}>{fotos.length}</span> {fotos.length === 1 ? ui.fotografia : ui.fotografias}<span class="galeria-pista"> · {ui.tocaFotoAmpliar}</span>
      </p>

      <div class="mosaico" data-mosaico data-descs={JSON.stringify(descs.map(d => d.texto))}>
        {fotosGrilla.map((f: any) => (
          <button class="foto" data-grande={f.grande} data-alt={f.alt}
                  data-categoria={f.categoria} data-ambiente={f.ambiente}
                  aria-label={`${uiG.fotografiaAmpliada}: ${f.alt}`}>
            <img src={f.image} alt={f.alt} width={f.width} height={f.height} loading="lazy" draggable="false">
          </button>
        ))}
      </div>

      <div class="lightbox" role="dialog" aria-modal="true" aria-label={uiG.fotografiaAmpliada} aria-hidden="true">
        <button class="lightbox__btn lightbox__cerrar" aria-label={uiG.cerrar}>&times;</button>
        <button class="lightbox__btn lightbox__ant" aria-label={uiG.anterior}>&#8249;</button>
        <img src="" alt="" aria-hidden="true">
        <button class="lightbox__btn lightbox__sig" aria-label={uiG.siguiente}>&#8250;</button>
        <p class="lightbox__descripcion"></p>
        <p class="lightbox__cuenta"></p>
      </div>

    </div>
  </section>

  <Franja franja={p.franja} whatsapp={whatsapp} locale={locale} />
</Layout>
