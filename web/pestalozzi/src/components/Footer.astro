---
import { t, urlIdioma, UI, type Locale } from '../sanity/i18n';

interface Props {
  config: any;
  locale?: Locale;
}
const { config, locale = 'es' } = Astro.props;
const ui = UI[locale];

// Solo se pintan las redes que el colegio realmente cargó en el CMS: si
// mañana borran el TikTok, el ícono desaparece solo.
const redes = [
  {
    nombre: 'Facebook',
    url: config.facebook,
    path: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z',
  },
  {
    nombre: 'WhatsApp',
    url: `https://wa.me/${config.telefonoInternacional}`,
    path: 'M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Z',
    pathExtra:
      'M17.5 14.4c-.3-.2-1.7-.9-2-1s-.5-.1-.7.1-.7 1-.9 1.2-.4.2-.7 0a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.6-2c-.2-.3 0-.5.1-.6l.5-.6.3-.5v-.5l-1-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4A3.3 3.3 0 0 0 6 8.7a5.8 5.8 0 0 0 1.2 3 13 13 0 0 0 5 4.4c2.3.9 2.3.6 2.8.6a3 3 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4l-.6-.4Z',
  },
  {
    nombre: 'TikTok',
    url: config.tiktok,
    path: 'M16.6 5.8a4.3 4.3 0 0 1-3-4h-3.1v13.7a2.6 2.6 0 1 1-2.6-2.7c.3 0 .5 0 .8.1V9.7a5.7 5.7 0 0 0-.8-.1A5.8 5.8 0 1 0 13.7 15V9.3a7.3 7.3 0 0 0 4.3 1.4V7.6a4.3 4.3 0 0 1-1.4-1.8Z',
  },
].filter((r) => r.url);
---
<footer class="footer">
  <div class="contenedor">
    <div class="footer__rejilla">
      <div class="footer__marca">
        <img src="/img/marca/logo-blanco.svg" alt="Pestalozzi Ambato" width="287" height="268" loading="lazy">
        <p>{ui.footer.unidadEducativa} · {config.ciudad}, Ecuador</p>
      </div>
      <div>
        <h4>{ui.footer.institucion}</h4>
        <ul>
          <li><a href={urlIdioma('/#propuesta', locale)}>{ui.footer.propuestaEducativa}</a></li>
          <li><a href={urlIdioma('/#niveles', locale)}>{ui.footer.niveles}</a></li>
          <li><a href={urlIdioma('/nosotros', locale)}>{ui.footer.filosofia}</a></li>
          <li><a href={urlIdioma('/contacto', locale)}>{ui.footer.admisiones}</a></li>
          {config.moodleUrl && (
            <li>
              <a href={config.moodleUrl} target="_blank" rel="noopener">
                {t(config.moodleTexto, locale) || ui.aulaVirtualPorDefecto} &nearr;
              </a>
            </li>
          )}
        </ul>
      </div>
      <div>
        <h4>{ui.footer.contacto}</h4>
        <address>
          {config.direccionCalle}<br>
          {config.ciudad}, Ecuador<br>
          <a href={`mailto:${config.correo}`}>{config.correo}</a>
        </address>
      </div>
      <div>
        <h4>{ui.footer.siguenos}</h4>
        <div class="footer__redes">
          {redes.map((r) => (
            <a href={r.url} target="_blank" rel="noopener" aria-label={r.nombre}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={r.path}></path>
                {r.pathExtra && <path d={r.pathExtra}></path>}
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="footer__legal">
      <p set:html={ui.footer.legal('<span id="anio">2026</span>')} />
      <p>{config.ciudad} · Ecuador</p>
    </div>
    <nav class="footer__legales" aria-label={ui.footer.legales}>
      <a href={urlIdioma('/politica-de-privacidad', locale)}>{ui.footer.politicaPrivacidad}</a>
      <a href={urlIdioma('/politica-de-cookies', locale)}>{ui.footer.politicaCookies}</a>
      <a href={urlIdioma('/aviso-legal', locale)}>{ui.footer.avisoLegal}</a>
      <a href="#" data-abrir-preferencias-cookies>{ui.footer.preferenciasCookies}</a>
    </nav>
  </div>
</footer>
