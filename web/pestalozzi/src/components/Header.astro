---
// current: 'inicio' | 'nosotros' | 'galeria' | 'voluntariado' | 'contacto'
// ctaContacto: false en la página de Contacto — ahí el botón manda
// directo a WhatsApp en vez de repetir el enlace a sí misma.
import { t, urlIdioma, UI, type Locale } from '../sanity/i18n';

interface Props {
  current: 'inicio' | 'nosotros' | 'galeria' | 'voluntariado' | 'contacto';
  ctaContacto?: boolean;
  config: any;
  locale?: Locale;
}
const { current, ctaContacto = true, config, locale = 'es' } = Astro.props;
const ui = UI[locale];

const enlaces = [
  { id: 'inicio', href: urlIdioma('/', locale), texto: ui.nav.inicio },
  { id: 'nosotros', href: urlIdioma('/nosotros', locale), texto: ui.nav.nosotros },
  { id: 'galeria', href: urlIdioma('/galeria', locale), texto: ui.nav.galeria },
  { id: 'voluntariado', href: urlIdioma('/voluntariado', locale), texto: ui.nav.voluntariado },
  { id: 'contacto', href: urlIdioma('/contacto', locale), texto: ui.nav.contacto },
];

const whatsapp = `https://wa.me/${config.telefonoInternacional}`;

// El aula virtual es un sistema aparte del colegio (Moodle), no una sección
// del sitio: por eso va separada del menú y abre en otra pestaña. Si el
// colegio todavía no cargó la dirección, el enlace simplemente no aparece.
const aula = config.moodleUrl
  ? { url: config.moodleUrl, texto: t(config.moodleTexto, locale) || ui.aulaVirtualPorDefecto }
  : null;

// Selector de idioma: misma página, la otra versión. current + '' arma
// la ruta equivalente en cada idioma (todas comparten los mismos
// nombres de página en las dos direcciones).
const RUTAS: Record<string, string> = {
  inicio: '/', nosotros: '/nosotros', galeria: '/galeria',
  voluntariado: '/voluntariado', contacto: '/contacto',
};
const rutaActual = RUTAS[current] ?? '/';
const otroIdioma: Locale = locale === 'es' ? 'en' : 'es';
---
<header class="header">
  <div class="contenedor header__inner">
    <a href="/" class="header__logo" aria-label="Pestalozzi Ambato, inicio">
      {/* Dos versiones: el logo verde sobre el header claro, y el blanco
          cuando la cortina del menú lo deja sobre fondo verde. El verde
          sobre verde da 1,41:1 — no se ve. El CSS alterna cuál se
          muestra; el alt va solo en uno para no repetirlo al lector.

          En SVG, extraído del .ai original: pesa un tercio que el PNG
          (17 KB contra 51) y se ve nítido en pantallas retina, donde el
          PNG a 287px de ancho se veía blando. */}
      <img class="header__logo-color" src="/img/marca/logo.svg" alt="Unidad Educativa Pestalozzi Ambato" width="287" height="268">
      <img class="header__logo-blanco" src="/img/marca/logo-blanco.svg" alt="" width="287" height="268" aria-hidden="true">
    </a>
    <nav class="nav" aria-label="Navegación principal">
      {enlaces.map((e) => (
        e.id === current
          ? <a href={e.href} class="activo" aria-current="page">{e.texto}</a>
          : <a href={e.href}>{e.texto}</a>
      ))}
    </nav>
    {aula && (
      <a href={aula.url} class="header__aula" target="_blank" rel="noopener">
        {aula.texto}
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <path d="M15 3h6v6"/><path d="M10 14 21 3"/>
        </svg>
      </a>
    )}
    {/* data-iman: lo sigue el cursor desde componentes.js, sin envoltorio
        de React. Un div de más en el header era justamente lo que
        complicaba el display:none en celular. */}
    {ctaContacto ? (
      <a href={urlIdioma('/contacto', locale)} class="btn btn--acento header__cta" data-iman>{t(config.textoBotonAdmisiones, locale)}</a>
    ) : (
      <a href={whatsapp} class="btn btn--acento header__cta" data-iman target="_blank" rel="noopener">{ui.escribenos}</a>
    )}
    <a href={urlIdioma(rutaActual, otroIdioma)} class="header__idioma" hreflang={otroIdioma}
       aria-label={otroIdioma === 'en' ? 'Switch to English' : 'Cambiar a español'}>
      {otroIdioma === 'en' ? 'EN' : 'ES'}
    </a>
    <button class="hamburguesa" aria-label={ui.abrirMenu} aria-expanded="false" aria-controls="menu-movil">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="velo"></div>
<nav class="menu-movil" id="menu-movil" aria-label="Navegación móvil">
  {/* Agrupados aparte para que la numeración 01, 02… cuente solo los
      enlaces de sección, sin incluir el aula virtual ni el botón. */}
  <div class="menu-movil__enlaces">
    {enlaces.map((e) => <a href={e.href}>{e.texto}</a>)}
  </div>
  {aula && <a href={aula.url} target="_blank" rel="noopener">{aula.texto} &nearr;</a>}
  {ctaContacto ? (
    <a href={urlIdioma('/contacto', locale)} class="btn btn--acento">{t(config.textoBotonAdmisiones, locale)}</a>
  ) : (
    <a href={whatsapp} class="btn btn--acento" target="_blank" rel="noopener">{ui.escribenos}</a>
  )}
  <a href={urlIdioma(rutaActual, otroIdioma)} class="menu-movil__idioma" hreflang={otroIdioma}>
    {otroIdioma === 'en' ? 'English' : 'Español'}
  </a>
  <div class="menu-movil__datos">
    <a href={`tel:+${config.telefonoInternacional}`}>{config.telefono}</a><br>
    <a href={`mailto:${config.correo}`}>{config.correo}</a>
  </div>
</nav>
