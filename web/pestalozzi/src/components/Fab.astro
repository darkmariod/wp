---
interface Props {
  config: any;
}
const { config } = Astro.props;
---
<!-- Botón de contacto flotante: WhatsApp, llamada y correo en arco -->
<div class="fab" data-abierto="false">
  <a class="fab__opcion fab__opcion--wa" data-etiqueta="WhatsApp"
     href={`https://wa.me/${config.telefonoInternacional}`} target="_blank" rel="noopener"
     aria-label="Escribir por WhatsApp" tabindex="-1">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/>
      <path d="M17.5 14.4c-.3-.2-1.7-.9-2-1s-.5-.1-.7.1-.7 1-.9 1.2-.4.2-.7 0a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.6-2c-.2-.3 0-.5.1-.6l.5-.6.3-.5v-.5l-1-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4A3.3 3.3 0 0 0 6 8.7a5.8 5.8 0 0 0 1.2 3 13 13 0 0 0 5 4.4c2.3.9 2.3.6 2.8.6a3 3 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4l-.6-.4Z"/>
    </svg>
  </a>
  <a class="fab__opcion fab__opcion--tel" data-etiqueta="Llamar"
     href={`tel:+${config.telefonoInternacional}`} aria-label="Llamar por teléfono" tabindex="-1">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.2-1.1a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.8 2.1Z"/>
    </svg>
  </a>
  <a class="fab__opcion fab__opcion--correo" data-etiqueta="Correo"
     href={`mailto:${config.correo}`} aria-label="Enviar un correo" tabindex="-1">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>
    </svg>
  </a>
  <button class="fab__disparador" type="button" aria-expanded="false"
          aria-label="Abrir opciones de contacto">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d="M12 5v14M5 12h14"/>
    </svg>
  </button>
</div>
