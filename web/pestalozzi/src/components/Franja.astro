---
import { urlImagen, type ImagenSanity } from '../sanity/imagen';
import { t, type Locale } from '../sanity/i18n';

type CampoLocalizado = { es?: string; en?: string };

interface Props {
  franja: { titulo: CampoLocalizado; texto: CampoLocalizado; textoBoton: CampoLocalizado; foto: ImagenSanity };
  whatsapp: string;
  locale?: Locale;
}
const { franja, whatsapp, locale = 'es' } = Astro.props;
---
<section class="franja">
  <div class="franja__marco">
    <img class="franja__foto" src={urlImagen(franja.foto, 1600)} alt={franja.foto.alt} loading="lazy">
  </div>
  <div class="franja__velo"></div>
  <div class="contenedor">
    <h2>{t(franja.titulo, locale)}</h2>
    <p>{t(franja.texto, locale)}</p>
    <div class="franja__acciones">
      <a href={whatsapp} class="btn btn--acento" target="_blank" rel="noopener">{t(franja.textoBoton, locale)}</a>
      <slot />
    </div>
  </div>
</section>
